# Copy to .env and supply these values through your launcher/process environment.
# The application settings classes do not automatically load .env files.
# Required when invoking Gemini; the deterministic echo graph does not need it.
GOOGLE_API_KEY=

# Optional: only needed when [skills].mode = "s3" in settings.toml.
# Use a bucket name, not an s3:// or https:// URL.
# SKILL_S3_BUCKET=your-skills-bucket
# SKILL_S3_PREFIX=skills
# AWS_REGION=ap-northeast-1
# AWS_PROFILE=your-local-profile
# Production should use an IAM role instead of credentials stored in this file.

